# Copy these values into .env.local, then replace every placeholder.
# Generate secrets with: openssl rand -hex 32
MONGODB_URI=mongodb://localhost:27017
LLDAP_JWT_SECRET=replace-with-a-random-secret
LLDAP_KEY_SEED=replace-with-a-different-random-secret
LLDAP_LDAP_USER_PASS=replace-with-a-strong-admin-password
LLDAP_LDAP_BASE_DN=dc=hackohio,dc=local
LLDAP_HTTP_PORT=17170
LLDAP_LDAP_PORT=3890
TZ=UTC
