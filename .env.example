# Copy these values into .env.local, then replace every placeholder.
# Generate secrets with: openssl rand -hex 32
MONGODB_URI=mongodb://localhost:27017
LLDAP_JWT_SECRET=replace-with-a-random-secret
LLDAP_KEY_SEED=replace-with-a-different-random-secret
LLDAP_LDAP_USER_PASS=replace-with-a-strong-admin-password
LLDAP_LDAP_BASE_DN=dc=hackohio,dc=local
LLDAP_HTTP_PORT=17170
LLDAP_LDAP_PORT=3890
TZ=UTC
# Optional: exact ngrok hostname (no scheme) used to access `next dev`.
NGROK_HOST=your-subdomain.ngrok-free.app
# MCP URL embedded in the one-time install config on the API page.
# Next.js reads NEXT_PUBLIC_* from web/.env.local. When this is unset, the
# page uses https://hackohio-2026-eta.vercel.app/mcp.
NEXT_PUBLIC_MCP_URL=https://hackohio-2026-eta.vercel.app/mcp
# Origin of the board API. Login and signup forward here. No password in this file.
BOARD_API_URL=http://localhost:3001
