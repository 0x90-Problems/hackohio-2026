{
  "_note": "Same names as names.ts, for code that is not TypeScript (Python scripts, config files). Change both files together.",
  "scopes": ["tickets:read", "tickets:write", "comments:write", "tickets:close"],
  "claims": { "actor_type": "actor_type", "on_behalf_of": "on_behalf_of", "scopes": "scopes" },
  "actor_types": ["human", "agent"],
  "actor_fields": ["type", "id", "acting_for"],
  "ticket_status": ["backlog", "in_progress", "in_review", "done"],
  "project_key_pattern": "^[A-Z][A-Z0-9]{1,5}$",
  "category_slug_pattern": "^[a-z0-9]+(_[a-z0-9]+)*$",
  "category_colors": ["gray", "red", "orange", "amber", "green", "teal", "pink"],
  "project_templates": ["blank", "team-planning", "kanban", "feature-release", "bug-tracker", "iterative-development", "product-launch", "roadmap", "team-retrospective"],
  "agent_connection": ["mcp", "api_key"],
  "event_actions": ["ticket_created", "ticket_moved", "comment_added", "commit_linked", "ticket_closed"],
  "db_name": "hackathon",
  "collections": ["users", "projects", "agents", "agent_tokens", "tickets", "comments", "events"],
  "token_prefix": "clw_",
  "default_token_expiry_hours": 24,
  "mcp_tools": ["get_board", "create_ticket", "move_ticket", "add_comment", "link_commit", "watch_changes", "list_project_templates", "get_project_template", "create_project"]
}
